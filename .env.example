# --- Database (Neon, Supabase, or any Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/logiq?sslmode=require"

# --- NextAuth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
# Set to your deployed URL in production, http://localhost:3000 in dev
AUTH_URL="http://localhost:3000"
# Trust the host header (required on Vercel)
AUTH_TRUST_HOST="true"

# --- Google OAuth ---
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Anthropic Claude (Deep mode: agentic tool loop) ---
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-sonnet-4-5
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Fast mode provider (single-shot, no tools) ---
# Which provider powers Fast mode: "openrouter" (default) or "huggingface".
FAST_PROVIDER="openrouter"
# Model id for the chosen provider. Defaults: openrouter -> openai/gpt-4o-mini,
# huggingface -> meta-llama/Llama-3.1-8B-Instruct.
FAST_MODEL="openai/gpt-4o-mini"
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# https://huggingface.co/settings/tokens  (only needed if FAST_PROVIDER=huggingface)
HF_TOKEN=""

# --- Vercel Blob ---
# Created automatically when you connect a Blob store to your Vercel project.
# For local dev, get the token from `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""
